# Neon PostgreSQL — use the dev branch, never production.
# Server-only. Copy this file to .env.local and fill in real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Single administrator for the internal dashboard.
# Generate ADMIN_PASSWORD_HASH locally (see docs/admin-auth.md):
#   printf 'New admin password: '; IFS= read -rs P; printf '\n'
#   printf '%s' "$P" | pnpm admin:password; unset P
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:N=16384,r=8,p=1:REPLACE_WITH_SALT:REPLACE_WITH_HASH

# Random signing secret, at least 32 bytes. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Neon Object Storage (S3-compatible) — dev branch, private bucket.
# Server-only: the app signs short-lived upload/download URLs, so these keys
# never reach the browser. Create a branch credential in the Neon Console or
# with `neon credentials create --branch dev --scopes storage:read,storage:write`
# then copy the S3 values here. The `feedbacks` bucket must exist on the branch.
AWS_ENDPOINT_URL_S3=https://BRANCH_ID.storage.REGION.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEON_STORAGE_TOKEN_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_STORAGE_SECRET
FEEDBACK_BUCKET=feedbacks
